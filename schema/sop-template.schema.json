{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sop-template.schema.json",
  "title": "SOP 模板",
  "type": "object",
  "required": ["template_id", "name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "description": {"type": "string", "maxLength": 300},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{2,40}$"},
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "op", "value"],
          "properties": {
            "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,60}$"},
            "op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in"]},
            "value": {}
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "name", "action", "role_code", "due_rule"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "action": {"type": "string", "minLength": 1, "maxLength": 300},
          "role_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$"},
          "due_rule": {
            "type": "string",
            "pattern": "^(created_at\\+\\d+d|event\\.[a-z0-9_.]+\\+\\d+d)$"
          },
          "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
          "check_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {
                "text": {"type": "string", "minLength": 1, "maxLength": 120},
                "must_pass": {"type": "boolean"}
              }
            }
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "op", "value"],
            "properties": {
              "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,60}$"},
              "op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in"]},
              "value": {}
            }
          }
        }
      }
    },
    "output_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "type"],
            "additionalProperties": false,
            "properties": {
              "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,60}$"},
              "type": {"enum": ["string", "number", "boolean", "date", "enum"]},
              "options": {"type": "array", "items": {"type": "string"}},
              "required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["doc", "knowledge", "form", "external_link"]},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
